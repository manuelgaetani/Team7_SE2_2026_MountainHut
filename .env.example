# API
PORT=3000

# PostgreSQL
POSTGRES_USER=mountainhut
POSTGRES_PASSWORD=mountainhut
POSTGRES_DB=mountainhut
DATABASE_URL=postgresql://mountainhut:mountainhut@localhost:5432/mountainhut?schema=public

#JWT
JWT_SECRET=AuthenticationSecretKey
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=1

# Booking
BOOKING_TIMEZONE=Europe/Rome

# Email (SMTP). Left empty, every email goes to Mailpit (read them at http://localhost:8025):
# localhost:1025 in local development, the mailpit service in Docker.
# For a real server set SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mountain Hut <no-reply@mountain-hut.test>"
