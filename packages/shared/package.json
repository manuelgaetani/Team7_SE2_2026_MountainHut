{
  "name": "@mountain-hut/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and validation shared by the API and the web app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "contributors": [
    {
      "name": "Manuel Gaetani",
      "email": "manuel.gaetani@gmail.com"
    }
  ],
  "dependencies": {
    "zod": "^4.6.7"
  }
}
