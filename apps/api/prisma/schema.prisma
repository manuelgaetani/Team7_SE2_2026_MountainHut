// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HIKER
  EMPLOYEE
  WARDEN

  @@map("role")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String?  @unique
  password    String? // hash (bcrypt/argon2);
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  phone       String?
  role        Role     @default(HIKER)
  isTemporary Boolean  @default(false) @map("is_temporary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  notifications Notification[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum NotificationType {
  BOOKING_CONFIRMATION

  @@map("notification_type")
}

enum NotificationStatus {
  SENT
  FAILED

  @@map("notification_status")
}

// One row per email the system tried to send, delivered or not.
model Notification {
  id        Int                @id @default(autoincrement())
  type      NotificationType
  recipient String
  subject   String
  status    NotificationStatus
  // SMTP error message when status is FAILED.
  error     String?
  userId    Int?               @map("user_id")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}
