// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HIKER
  EMPLOYEE
  WARDEN

  @@map("role")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String // hash bcrypt
  role               Role     @default(HIKER)
  // True when an employee created the account: the hiker must set a new password at the next login.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hiker               Hiker?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  @@map("users")
}

model Hiker {
  id               Int      @id @default(autoincrement())
  userId           Int?     @unique @map("user_id")
  fullName         String   @map("full_name")
  // Optional only for temporary hikers: a CHECK constraint requires it when user_id is set.
  phone            String?
  notes            String?
  emergencyContact String?  @map("emergency_contact")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  hikes    Hike[]

  @@map("hikers")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per password reset link sent by email. Only the hash of the code is stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  // At most 24 hours after the creation.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // Set when the link is used since a code is valid only once.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum BookingStatus {
  CONFIRMED
  PENDING
  REJECTED
  CANCELLED

  @@map("booking_status")
}

model Slot {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  tables   SlotTable[]
  bookings Booking[]
  menu     Menu?

  @@unique([date, startTime, endTime])
  @@map("slots")
}

// MH-10: the menu of a slot, at most one. Free text with a small Markdown subset (bold, italic,
// item lists with sub items), stored as written. Deleted with its slot.
model Menu {
  slotId    Int      @id @map("slot_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("menus")
}

model SlotTable {
  slotId      Int @map("slot_id")
  tableNumber Int @map("table_number")
  seats       Int

  slot          Slot           @relation(fields: [slotId], references: [id])
  bookingTables BookingTable[]

  @@id([slotId, tableNumber])
  @@map("slot_tables")
}

model Booking {
  id        Int @id @default(autoincrement())
  hikerId   Int @map("hiker_id")
  slotId    Int @map("slot_id")
  partySize Int @map("party_size")

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  hiker         Hiker              @relation(fields: [hikerId], references: [id])
  slot          Slot               @relation(fields: [slotId], references: [id])
  tables        BookingTable[]
  requirements  PartyRequirement[]
  notifications Notification[]

  // A partial unique index on (hikerId, slotId) ignores rejected and cancelled bookings: see the
  // one_booking_per_slot and one_booking_per_slot_ignores_cancelled migrations.
  @@unique([id, slotId])
  @@index([hikerId])
  @@index([slotId])
  @@map("bookings")
}

model BookingTable {
  bookingId     Int @map("booking_id")
  slotId        Int @map("slot_id")
  tableNumber   Int @map("table_number")
  assignedSeats Int @map("assigned_seats")

  booking   Booking   @relation(fields: [bookingId, slotId], references: [id, slotId])
  slotTable SlotTable @relation(fields: [slotId, tableNumber], references: [slotId, tableNumber])

  @@id([bookingId, slotId, tableNumber])
  @@map("booking_tables")
}

// Needs of a subset of the party (e.g. "2 vegetarians"); a booking has zero or more.
model PartyRequirement {
  id           Int      @id @default(autoincrement())
  bookingId    Int      @map("booking_id")
  allergies    Boolean
  description  String
  // Needs picked from the list of the hut (DIETARY_OPTIONS in @mountain-hut/shared).
  restrictions String[] @default([])

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("party_requirements")
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CHANGE

  PASSWORD_RESET

  @@map("notification_type")
}

enum NotificationStatus {
  SENT
  FAILED

  @@map("notification_status")
}

// One row per email the system tried to send, delivered or not.
model Notification {
  id        Int                @id @default(autoincrement())
  type      NotificationType
  recipient String
  subject   String
  status    NotificationStatus
  // SMTP error message when status is FAILED.
  error     String?
  userId    Int?               @map("user_id")
  bookingId Int?               @map("booking_id")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@map("notifications")
}

// MH-20: a hike of the hut's list, picked by the hiker to fill the registration (issue #49).
model PredefinedHike {
  id            Int      @id @default(autoincrement())
  destination   String
  route         String
  passagePoints String[] @default([]) @map("passage_points")

  hikes Hike[]

  @@unique([destination, route])
  @@map("predefined_hikes")
}

// MH-20: a hike registered by a hiker before departure. Departure and return are the hut's local
// date and time, stored without time zone like the slots; a CHECK keeps the return after the
// departure.
model Hike {
  id               Int      @id @default(autoincrement())
  hikerId          Int      @map("hiker_id")
  // Copy of the hike of the list the hiker started from; the fields below are the registered ones.
  predefinedHikeId Int?     @map("predefined_hike_id")
  destination      String
  route            String
  passagePoints    String[] @default([]) @map("passage_points")
  departureAt      DateTime @map("departure_at") @db.Timestamp(0)
  returnAt         DateTime @map("return_at") @db.Timestamp(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hiker          Hiker           @relation(fields: [hikerId], references: [id], onDelete: Cascade)
  predefinedHike PredefinedHike? @relation(fields: [predefinedHikeId], references: [id], onDelete: SetNull)

  @@index([hikerId, departureAt])
  @@index([predefinedHikeId])
  @@map("hikes")
}
