// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HIKER
  EMPLOYEE
  WARDEN

  @@map("role")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String?  @unique
  password    String? // hash (bcrypt/argon2);
  firstName   String   @map("first_name")
  lastName    String?  @map("last_name")
  phone       String?
  role        Role     @default(HIKER)
  isTemporary Boolean  @default(false) @map("is_temporary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings      Booking[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum BookingStatus {
  CONFIRMED
  PENDING
  REJECTED

  @@map("booking_status")
}

model Slot {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  tables   SlotTable[]
  bookings Booking[]

  @@unique([date, startTime, endTime])
  @@map("slots")
}

model SlotTable {
  slotId      Int @map("slot_id")
  tableNumber Int @map("table_number")
  seats       Int

  slot          Slot           @relation(fields: [slotId], references: [id])
  bookingTables BookingTable[]

  @@id([slotId, tableNumber])
  @@map("slot_tables")
}

model Booking {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  slotId    Int           @map("slot_id")
  partySize Int           @map("party_size")
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User           @relation(fields: [userId], references: [id])
  slot   Slot           @relation(fields: [slotId], references: [id])
  tables BookingTable[]

  @@index([userId])
  @@index([slotId])
  @@map("bookings")
}

model BookingTable {
  bookingId     Int @map("booking_id")
  slotId        Int @map("slot_id")
  tableNumber   Int @map("table_number")
  assignedSeats Int @map("assigned_seats")

  booking   Booking   @relation(fields: [bookingId], references: [id])
  slotTable SlotTable @relation(fields: [slotId, tableNumber], references: [slotId, tableNumber])

  @@id([bookingId, slotId, tableNumber])
  @@map("booking_tables")
}
