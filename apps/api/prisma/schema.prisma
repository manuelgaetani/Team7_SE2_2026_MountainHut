// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HIKER
  EMPLOYEE
  WARDEN

  @@map("role")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String // hash bcrypt
  role               Role     @default(HIKER)
  // True when an employee created the account: the hiker must set a new password at the next login.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hiker               Hiker?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]

  @@map("users")
}

model Hiker {
  id               Int      @id @default(autoincrement())
  userId           Int?     @unique @map("user_id")
  fullName         String   @map("full_name")
  // Optional only for temporary hikers: a CHECK constraint requires it when user_id is set.
  phone            String?
  notes            String?
  emergencyContact String?  @map("emergency_contact")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("hikers")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per password reset link sent by email. Only the hash of the code is stored.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  // At most 24 hours after the creation.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // Set when the link is used since a code is valid only once.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum BookingStatus {
  CONFIRMED
  PENDING
  REJECTED

  @@map("booking_status")
}

model Slot {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  tables   SlotTable[]
  bookings Booking[]

  @@unique([date, startTime, endTime])
  @@map("slots")
}

model SlotTable {
  slotId      Int @map("slot_id")
  tableNumber Int @map("table_number")
  seats       Int

  slot          Slot           @relation(fields: [slotId], references: [id])
  bookingTables BookingTable[]

  @@id([slotId, tableNumber])
  @@map("slot_tables")
}

model Booking {
  id           Int           @id @default(autoincrement())
  hikerId      Int           @map("hiker_id")
  slotId       Int           @map("slot_id")
  partySize    Int           @map("party_size")
  // Party needs typed by the hiker (e.g. allergies).
  requirements String?
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  hiker         Hiker          @relation(fields: [hikerId], references: [id])
  slot          Slot           @relation(fields: [slotId], references: [id])
  tables        BookingTable[]
  notifications Notification[]

  // A partial unique index on (hikerId, slotId) ignores rejected bookings: see the
  // one_booking_per_slot migration.
  @@unique([id, slotId])
  @@index([hikerId])
  @@index([slotId])
  @@map("bookings")
}

model BookingTable {
  bookingId     Int @map("booking_id")
  slotId        Int @map("slot_id")
  tableNumber   Int @map("table_number")
  assignedSeats Int @map("assigned_seats")

  booking   Booking   @relation(fields: [bookingId, slotId], references: [id, slotId])
  slotTable SlotTable @relation(fields: [slotId, tableNumber], references: [slotId, tableNumber])

  @@id([bookingId, slotId, tableNumber])
  @@map("booking_tables")
}

enum NotificationType {
  BOOKING_CONFIRMATION

  @@map("notification_type")
}

enum NotificationStatus {
  SENT
  FAILED

  @@map("notification_status")
}

// One row per email the system tried to send, delivered or not.
model Notification {
  id        Int                @id @default(autoincrement())
  type      NotificationType
  recipient String
  subject   String
  status    NotificationStatus
  // SMTP error message when status is FAILED.
  error     String?
  userId    Int?               @map("user_id")
  bookingId Int?               @map("booking_id")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@map("notifications")
}
